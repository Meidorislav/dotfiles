#!/bin/sh
# Toggles a screen recording with gpu-screen-recorder: the first run starts
# recording (niri asks once what to capture and remembers it), the next one
# stops and saves it to ~/Videos. Records the system sound and the default
# microphone mixed into one track.
set -e

dir="${XDG_VIDEOS_DIR:-$HOME/Videos}"
state="${XDG_RUNTIME_DIR:-/tmp}/screen-record.path"

notify() {
    gdbus call --session --dest org.freedesktop.Notifications \
        --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.Notify \
        "Screen recorder" 0 "media-record" "$1" "$2" '[]' '{}' 4000 >/dev/null 2>&1 || true
}

# Matched by command line: process names are cut to 15 characters
# ("gpu-screen-reco"), so `pgrep -x gpu-screen-recorder` never finds it.
recorder='^gpu-screen-recorder '

if pgrep -f "$recorder" >/dev/null; then
    pkill -INT -f "$recorder"
    # Wait for the file to be finalized before announcing it.
    while pgrep -f "$recorder" >/dev/null; do
        sleep 0.2
    done
    file=$(cat "$state" 2>/dev/null || true)
    rm -f "$state"
    notify "Recording saved" "${file:-$dir}"
else
    mkdir -p "$dir"
    file="$dir/$(date +%Y-%m-%d_%H-%M-%S).mp4"
    echo "$file" > "$state"
    gpu-screen-recorder -w portal -restore-portal-session yes -f 60 \
        -a "default_output|default_input" -o "$file" >/dev/null 2>&1 &
    notify "Recording started" "Press Mod+Alt+R again to stop"
fi
